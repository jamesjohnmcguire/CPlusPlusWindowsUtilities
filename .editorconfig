root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = tab
insert_final_newline = true
max_line_length = 80
tab_width = 4

[*.{cmd,bat}]
end_of_line = crlf

[*.{md,yml,yaml}]
indent_size = 4
indent_style = space

[*.{cs,vb}]

# IDE0017: Simplify object initialization
dotnet_style_object_initializer = false
